<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5"
    tools:context=".demo.controls.ProgressBarDemoActivity">

    <include layout="@layout/item_toolbar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/padding_standard">

            <include layout="@layout/item_explanation"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                android:text="1. Basic ProgressBar - Indeterminate"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"/>
            <ProgressBar
                android:id="@+id/progressBarLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/padding_standard"
                android:indeterminate="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                android:text="2. Basic ProgressBar - Horizontal"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"/>
            <ProgressBar
                android:id="@+id/progressBarBasic"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                android:max="100"
                android:progress="40"/>
            <TextView
                android:id="@+id/tvProgressBasic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                android:gravity="center"
                android:text="Progress: 40 / 100"
                android:textColor="#1976D2"
                android:textSize="@dimen/text_size_desc"
                android:textStyle="bold"/>
            <Button
                android:id="@+id/btnIncreaseProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/padding_standard"
                android:text="Tăng Progress"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                android:text="3. Custom ProgressBar - progressDrawable"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"/>
            <ProgressBar
                android:id="@+id/progressBarCustom"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginTop="@dimen/padding_standard"
                android:max="100"
                android:progress="70"
                android:progressDrawable="@drawable/progressbar_custom"/>
            <TextView
                android:id="@+id/tvProgressCustom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:gravity="center"
                android:text="Progress: 70 / 100"
                android:textColor="#1976D2"
                android:textSize="@dimen/text_size_desc"
                android:textStyle="bold"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>