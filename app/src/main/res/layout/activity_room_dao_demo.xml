<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#D5F0FB"
        tools:context=".demo.roomdb.RoomDaoDemoActivity">

        <include
            android:id="@+id/includeToolbar"
            layout="@layout/item_toolbar"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_standard">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Room DAO"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="DAO (Data Access Object) là nơi định nghĩa các phương thức tương tác với Room Database như thêm, sửa, xóa và truy vấn dữ liệu."
                    android:textColor="#666666"
                    android:textSize="@dimen/text_size_desc"/>

                <include
                    android:id="@+id/layout_dao_overview"
                    layout="@layout/item_room_card_dao_overview"/>

                <include
                    android:id="@+id/layout_dao_anatomy"
                    layout="@layout/item_room_section_dao_anatomy"/>

                <include
                    android:id="@+id/layout_dao_convenience"
                    layout="@layout/item_room_section_dao_convenience_functions"/>

                <include
                    android:id="@+id/layout_dao_queries"
                    layout="@layout/item_section_dao_queries"/>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>
</layout>