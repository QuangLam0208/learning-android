<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    tools:context=".practice.ContactInfoActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#287bfb"
        android:orientation="vertical"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Thông tin liên hệ"
            android:textColor="@color/white"
            android:textFontWeight="500"
            android:textSize="22sp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Tên Công Ty"
                android:textColor="@color/black"
                android:textFontWeight="500"
                android:textSize="@dimen/text_size_desc"/>
            <EditText
                android:id="@+id/edtCompanyName"
                style="@style/CommonEditText"
                android:layout_marginTop="3dp"
                android:hint="Nhập tên Công Ty"
                android:inputType="text"
                android:singleLine="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Họ và Tên"
                android:textColor="@color/black"
                android:textFontWeight="500"
                android:textSize="@dimen/text_size_desc"/>
            <EditText
                android:id="@+id/edtFullName"
                style="@style/CommonEditText"
                android:layout_marginTop="3dp"
                android:hint="Họ và Tên"
                android:inputType="text"
                android:singleLine="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Email"
                android:textColorHint="#C4C4C4"
                android:textColor="@color/black"
                android:textFontWeight="500"
                android:textSize="@dimen/text_size_desc"/>
            <EditText
                android:id="@+id/edtEmail"
                style="@style/CommonEditText"
                android:layout_marginTop="3dp"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:text="abc@gmail.com"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Số điện thoại"
                android:textColor="@color/black"
                android:textFontWeight="500"
                android:textSize="@dimen/text_size_desc"/>
            <EditText
                android:id="@+id/edtPhone"
                style="@style/CommonEditText"
                android:layout_marginTop="3dp"
                android:hint="Nhập số điện thoại"
                android:inputType="phone"
                android:singleLine="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Vui lòng tư vấn cho tôi"
                android:textColor="@color/black"
                android:textFontWeight="500"
                android:textSize="@dimen/text_size_desc"/>
            <EditText
                android:id="@+id/edtMessage"
                style="@style/CommonEditText"
                android:layout_height="120dp"
                android:layout_marginTop="3dp"
                android:gravity="top|start"
                android:hint="Vui lòng nhập lời nhắn"
                android:inputType="textMultiLine"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/rounded_button_background"
                android:backgroundTint="@null"
                android:gravity="center"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Gửi"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textFontWeight="500"
                android:textSize="18sp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>