<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        tools:context=".demo.dagger.DaggerOverviewDemoActivity">

        <include
            android:id="@+id/includeToolbar"
            layout="@layout/item_toolbar"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/padding_standard">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_desc"
                    android:lineSpacingExtra="3dp"
                    app:renderHtml="@{@string/dagger_overview_explanation}" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Dagger giải quyết vấn đề gì trong thực tế?"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="❌ Spaghetti Singleton / Static Factory: viết ApiClient.getInstance(context) thủ công, dễ leak Context nếu vô tình giữ Activity Context ở biến static."
                            android:textColor="#666666"
                            android:textSize="14sp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="✅ Dagger quản lý vòng đời tập trung qua Component/Scope, không cần static singleton thủ công."
                            android:textColor="#1976D2"
                            android:textSize="14sp"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="#EEEEEE" android:layout_marginVertical="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="❌ Boilerplate &amp; phụ thuộc chéo: C cần B, B cần A -&gt; phải new A -&gt; new B -&gt; new C thủ công ở mọi nơi dùng C."
                            android:textColor="#666666"
                            android:textSize="14sp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="✅ Dependency graph tự động: chỉ cần yêu cầu C, Dagger tự tìm cách tạo A rồi B rồi ghép vào C."
                            android:textColor="#1976D2"
                            android:textSize="14sp"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="#EEEEEE" android:layout_marginVertical="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="❌ Khó Unit Test: viết cứng new TodoRepository(new TodoDAO(...)) thì không thể thay bằng Mock khi test."
                            android:textColor="#666666"
                            android:textSize="14sp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="✅ Chỉ cần inject Mock Repository/Fake ApiService, không sửa code UI."
                            android:textColor="#1976D2"
                            android:textSize="14sp"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:background="#EEEEEE" android:layout_marginVertical="10dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="❌ Tái sử dụng tài nguyên kém: mỗi nơi tự new OkHttpClient/Retrofit -&gt; nhiều connection pool, tốn RAM/pin."
                            android:textColor="#666666"
                            android:textSize="14sp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="✅ Tài nguyên nặng (Retrofit, OkHttpClient, Database) chỉ khởi tạo 1 lần nhờ Scope, tái sử dụng toàn app."
                            android:textColor="#1976D2"
                            android:textSize="14sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Khi nào nên dùng Dagger?"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="#E8F5E9"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="NÊN DÙNG KHI:"
                            android:textColor="#2E7D32"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="• Ứng dụng vừa/lớn, nhiều màn hình\n• Áp dụng kiến trúc chuẩn (MVVM, MVI, Clean Architecture)\n• Có nhiều module: Network, Database, Session/Token, Analytics, Caching"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#FFEBEE"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="KHÔNG CẦN THIẾT KHI:"
                            android:textColor="#C62828"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="• App rất nhỏ (1-2 màn hình demo UI tĩnh, script mini)\n• Cấu hình Component/Module lúc này gây cồng kềnh không đáng có (over-engineering)"
                            android:textColor="#333333"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>