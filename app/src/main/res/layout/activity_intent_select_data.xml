<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="activity"
            type="com.persy.learnandroid.demo.intent.SelectDataActivity" />
    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#f5f5f5"
        tools:context=".demo.intent.SelectDataActivity">

        <include
            android:id="@+id/includeToolbar"
            layout="@layout/item_toolbar"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_standard">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select Data"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_title"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:text="Chọn một giá trị để trả về Activity trước."
                android:textColor="#666666"
                android:textSize="@dimen/text_size_desc"/>

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard">
                <RadioButton
                    android:id="@+id/radioAndroid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Android"
                    android:textSize="@dimen/text_size_desc"/>
                <RadioButton
                    android:id="@+id/radioJava"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Java"
                    android:textSize="@dimen/text_size_desc"/>
                <RadioButton
                    android:id="@+id/radioKotlin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kotlin"
                    android:textSize="@dimen/text_size_desc"/>
            </RadioGroup>

            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_standard"
                android:text="Xác nhận"
                android:onClick="@{() -> activity.onConfirm()}"/>
            <Button
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hủy"
                android:onClick="@{() -> activity.onCancel()}"/>

        </LinearLayout>

    </LinearLayout>
</layout>