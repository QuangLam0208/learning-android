<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GridButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minWidth">80dp</item>
        <item name="android:minHeight">80dp</item>
    </style>
    <style name="DemoTextButton" parent="Widget.Material3.Button.TextButton">
    </style>

    <style name="TextViewDemoStyle">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#1976D2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">@dimen/padding_standard</item>
        <item name="android:background">#E3F2FD</item>
    </style>

<!--    Practice-->
    <style name="CommonEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/rounded_edittext_background</item>
        <item name="android:textColorHint">#C4C4C4</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>